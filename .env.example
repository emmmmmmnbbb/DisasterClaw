# ============================================================
# DisasterClaw Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ── Active Provider ──────────────────────────────────────────
# openai / ollama_local / deepseek / moonshot / zhipu
ACTIVE_PROVIDER=openai

# ── LLM (OpenAI-compatible) ─────────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini

# ── VLM (Vision / Qwen2-VL / Qwen2.5-VL) ───────────────────
# Mode A: OpenAI-compatible / Ollama API
# Example model IDs: qwen2.5vl:7b / qwen2vl / your custom served model name
VLM_PROVIDER=vlm
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT=180
# auto / ollama / openai
VLM_IMAGE_INPUT_MODE=auto

# Mode B: rs_agent_system-style local Transformers backend
# Set VLM_PROVIDER=qwen_vl_local to enable direct local loading.
# BASE_MODEL can be a HuggingFace model id or a local model directory.
# CHECKPOINT_PATH is optional LoRA weights path.
# Example:
# VLM_PROVIDER=qwen_vl_local
# BASE_MODEL=/path/to/Qwen2.5-VL-7B-Instruct
# CHECKPOINT_PATH=
# VLM_LOCAL_DEVICE=auto
# VLM_LOCAL_TORCH_DTYPE=auto
# VLM_LOCAL_MIN_FREE_GPU_GB=12
# VLM_LOCAL_TOP_P=0.9
# VLM_LOCAL_REPETITION_PENALTY=1.1

# ── Ollama (Local) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── DeepSeek ────────────────────────────────────────────────
# DEEPSEEK_API_KEY=your-deepseek-key-here

# ── Moonshot (Kimi) ─────────────────────────────────────────
# MOONSHOT_API_KEY=your-moonshot-key-here

# ── Zhipu (GLM) ─────────────────────────────────────────────
# ZHIPU_API_KEY=your-zhipu-key-here

# ── Optional module overrides ───────────────────────────────
# PLANNER_LLM_PROVIDER=
# PLANNER_LLM_MODEL=

# ── Server ──────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=5011

# ── Frontend dev server ─────────────────────────────────────
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# ── xBD disaster map ────────────────────────────────────────
# Root of the xBD/xView2 dataset on disk. Defaults to ~/datasets/xbd.
XBD_DATASET_ROOT=~/datasets/xbd

# Optional: point to a pre-built manifest.json / footprints.geojson.
# Defaults to backend/data/<DATASET_MODE>/{manifest,footprints}.*.
# XBD_MANIFEST_PATH=
# XBD_FOOTPRINTS_PATH=

# ── Dataset source ─────────────────────────────────────────────────────
# xbd       : 2019 xView Building Damage satellite tiles (1024×1024, GSD≈0.5m/px).
# rescuenet : 2018 Hurricane Michael DJI drone imagery (4000×3000, GSD≈0.02m/px,
#             ~25× higher resolution — highly recommended for YOLO/SegFormer).
#             Requires /home/lc/tune7b + `python scripts/build_rescuenet_dataset.py`.
DATASET_MODE=xbd

# Default disaster to activate on startup (must have has_georef tiles).
# xbd default: palu-tsunami；rescuenet default: hurricane-michael
# XBD_DEFAULT_DISASTER=palu-tsunami
XBD_DEFAULT_STAGE=post

# Default tile to activate on startup. If set and the tile has has_georef + POST,
# it wins over XBD_DEFAULT_DISASTER.
# xbd default      : palu-tsunami_00000118_post_disaster (~1540 destroyed buildings)
# rescuenet default: rescuenet_12215_post_disaster       (4 destroyed + 14 major)
# XBD_DEFAULT_TILE=

# Only load post_disaster tiles (catalog + footprints + activate). Set to 0 to
# also expose pre_disaster tiles in the UI/API. Defaults to 1.
XBD_POST_ONLY=1

# Basemap used by the frontend (Leaflet tileLayer). esri-world-imagery / osm.
XBD_BASEMAP=esri-world-imagery

# Open-Meteo elevation endpoint used by /api/elevation. Keep the default
# unless you self-host. Set XBD_ELEVATION_DISABLE=1 to skip the call entirely.
XBD_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
XBD_ELEVATION_TIMEOUT=4

# ── Perception (YOLO + SegFormer, rs_agent_system-compatible) ─────────
# Backs the `detect_disaster` planner skill. The backend drops these paths
# into sys.path and imports YOLOTool / SegFormerTool / SceneDescriptor from
# the existing mars/rs_agent_system trees (no code duplication).
RS_AGENT_SYSTEM_PATH=/home/lc/rs_agent_system
VISION_TOOLS_PATH=/home/lc/Langchain-Chatchat/tools/mars/tools
VISION_RESULTS_PATH=/home/lc/Langchain-Chatchat/tools/mars/results/yolo
# Building proposer: unet (default ResNet34 localization; damage labels from
# change_perception) | yolo (legacy detector rollback).
BUILDING_PROPOSER=unet
BUILDING_LOC_CKPT=./backend/outputs/building_localization/resnet34_strict_v1.pt
BUILDING_LOC_CONF=0.45
BUILDING_LOC_MIN_AREA=64
BUILDING_LOC_DILATE=3
# YOLO weights kept for BUILDING_PROPOSER=yolo rollback only.
YOLO_WEIGHTS=./runs/train/xbd_yolov8s_strict_v1/weights/best.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IMGSZ=1024
SEGFORMER_MODEL=nvidia/segformer-b2-finetuned-ade-512-512
ADE20K_CLASSES_PATH=/home/lc/Langchain-Chatchat/tools/mars/tools/ade20k_classes.json

# Output dir for UAV view patches + YOLO/SegFormer visualizations.
# Served read-only at /api/perception/view/<fname>.
PERCEPTION_OUTPUT_DIR=./outputs/uav_view
# cuda / cuda:0 / cuda:1 / cpu
PERCEPTION_DEVICE=cuda:0
# Patch radius in meters ≈ UAV altitude * factor, clipped to [MIN_RADIUS_M, MAX_RADIUS_M].
PERCEPTION_VIEW_ALT_FACTOR=2.0
PERCEPTION_MIN_RADIUS_M=20
PERCEPTION_MAX_RADIUS_M=300
PERCEPTION_MIN_PATCH_PX=256
PERCEPTION_MAX_PATCH_PX=1024
# Set to 0 to disable background warmup of YOLO + SegFormer at startup.
PERCEPTION_WARMUP=1
# Required for damage class labels when BUILDING_PROPOSER=unet.
VLN_CHANGE_PERCEPTION=1
CHANGE_PERCEPTION_CKPT=./backend/outputs/change_perception/strict_diff_attention_seed0_v2.pt
# X1: simulate cruise GSD by 4× downsample+blur at 30 m; native at 10 m.
GSD_LADDER=1
VLN_ENTROPY_TABLE=./backend/data/gsd_entropy_table.json
VLN_RECHECK_TRIGGER=info_gain
VLN_UNCERTAINTY_MODE=entropy
# Local VLM for hybrid grounding (start with: ollama serve && ollama pull qwen2.5vl:7b)
ACTIVE_PROVIDER=ollama_local
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_MODEL=qwen2.5vl:7b
